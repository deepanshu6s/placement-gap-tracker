# ==============================================================================
# SMART PLACEMENT READINESS & SKILL GAP TRACKER
# Root Environment Template (Copy to .env for local configuration)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend Server Port
PORT=5000

# PostgreSQL Configuration (Matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placement_tracker
DB_USER=postgres
DB_PASSWORD=postgres_password_dev

# Full Database Connection String
DATABASE_URL=postgresql://postgres:postgres_password_dev@localhost:5432/placement_tracker

# Frontend Origin for Backend CORS
FRONTEND_URL=http://localhost:5173

# Frontend Vite API Base URL (Used by React Vite client)
VITE_API_URL=http://localhost:5000/api

# Authentication Configuration (REQUIRED)
# Both secrets MUST be explicitly defined and at least 32 characters long.
# Generate secure random strings via: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_placeholder
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters_placeholder
REFRESH_TOKEN_EXPIRES_DAYS=7

