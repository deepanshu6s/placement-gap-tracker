# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env for local runtime execution
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placement_tracker
DB_USER=postgres
DB_PASSWORD=postgres_password_dev

# Full PostgreSQL Connection URL (Used by node-pg-migrate and connection pool)
DATABASE_URL=postgresql://postgres:postgres_password_dev@localhost:5432/placement_tracker

# Frontend Origin for CORS Validation
FRONTEND_URL=http://localhost:5173

# Authentication Configuration (REQUIRED)
# Both secrets MUST be explicitly defined and at least 32 characters long.
# Generate secure random strings via: openssl rand -hex 32
JWT_SECRET=c253957acc6aeac89baabe662435f9ec9e267171ca788950d7b87b8c467c5aa8
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=801023ce54784dd89627153a4f9d915bc70499cbe03f19ef25b23fab3594f9ac
REFRESH_TOKEN_EXPIRES_DAYS=7

